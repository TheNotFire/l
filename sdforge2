        "\n",
        "    # Handle Civitai Token\n",
        "    if civitai_token and \"civitai.com\" in url:\n",
        "        if \"token=\" not in url:\n",
        "            separator = \"&\" if \"?\" in url else \"?\"\n",
        "            url = f\"{url}{separator}token={civitai_token}\"\n",
        "\n",
        "    # Fix HuggingFace links\n",
        "    url = url.replace(\"blob/main\", \"resolve/main\")\n",
        "\n",
        "    # Base aria2c command\n",
        "    cmd = f\"aria2c --console-log-level=error -c -x 16 -s 16 -k 1M\"\n",
        "    if filename:\n",
        "        cmd += f\" -o '{filename}'\"\n",
        "    cmd += f\" '{url}' -d '{destination_dir}'\"\n",
        "    os.system(cmd)\n",
        "\n",
