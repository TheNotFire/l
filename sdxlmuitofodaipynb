        "# @title 1. Download Models (Checkpoints, LoRAs, ADetailer) [ULTIMATE FIX]\n",
        "\n",
        "import os\n",
        "import time\n",
        "import subprocess\n",
        "import requests\n",
        "import re\n",
        "from urllib.parse import unquote\n",
        "from tqdm import tqdm\n",
        "\n",
        "# --- CONFIGURATION ---\n",
        "civitai_token = \"6ce4a08c7b3986b710f40ab916a68386\" # @param {type:\"string\"}\n",
        "civitai_token = civitai_token.strip()\n",
        "\n",
        "# --- CUSTOM MODEL URLS ---\n",
        "custom_model_url = \"https://civitai.red/api/download/models/2837020?type=Model&format=SafeTensor&size=pruned&fp=fp16\" # @param {type:\"string\"}\n",
        "custom_lora_url = \"https://civitai.red/api/download/models/2055853?type=Model&format=SafeTensor, https://civitai.red/api/download/models/1552087?type=Model&format=SafeTensor, https://civitai.red/api/download/models/1447126?type=Model&format=SafeTensor, https://civitai.red/api/download/models/2367109?type=Model&format=SafeTensor, https://civitai.red/api/download/models/1082928?type=Model&format=SafeTensor, https://civitai.red/api/download/models/1242320?type=Model&format=SafeTensor, https://civitai.red/api/download/models/1520880?type=Model&format=SafeTensor, https://civitai.red/api/download/models/1157361?type=Model&format=SafeTensor, https://civitai.red/api/download/models/1255291?type=Model&format=SafeTensor, https://civitai.red/api/download/models/1268434?type=Model&format=SafeTensor\" # @param {type:\"string\"}\n",
        "\n",
        "custom_adetailer_url = \"https://civitai.com/api/download/models/2350456?type=Archive&format=Other\" # @param {type:\"string\"}\n",
        "extra_adetailer_url = \"https://civitai.com/api/download/models/1780243?type=Archive&format=Other\" # @param {type:\"string\"}\n",
        "\n",
        "# Define Paths\n",
        "root_dir = \"/content\"\n",
        "repo_dir = os.path.join(root_dir, \"reForge\")\n",
        "models_dir = os.path.join(repo_dir, \"models\", \"Stable-diffusion\")\n",
        "lora_dir = os.path.join(repo_dir, \"models\", \"Lora\")\n",
        "lycoris_dir = os.path.join(repo_dir, \"models\", \"Lycoris\")\n",
        "adetailer_dir = os.path.join(repo_dir, \"models\", \"adetailer\")\n",
        "esrgan_dir = os.path.join(repo_dir, \"models\", \"ESRGAN\")\n",
        "\n",
        "# Create Folders Before Downloading\n",
        "print(\"[DEBUG] Creating directories...\")\n",
        "for d in[models_dir, lora_dir, lycoris_dir, adetailer_dir, esrgan_dir]:\n",
        "    os.makedirs(d, exist_ok=True)\n",
        "\n",
        "print(\"\\n[DEBUG] Installing Downloader (aria2)...\")\n",
        "os.system(\"apt-get update -qq && apt-get install -y aria2\")\n",
        "\n",
        "# --- BULLETPROOF DOWNLOADER FUNCTION ---\n",
        "def download_file(url, destination_dir, filename=None):\n",
        "    if not url: return\n",
        "    url = url.strip()\n",
        "\n",
        "    print(f\"\\n============================================================\")\n",
        "    print(f\"[DEBUG] STARTING DOWNLOAD\")\n",
        "\n",
        "    url = url.replace(\"civitai.red/api\", \"civitai.com/api\")\n",
        "    url = url.replace(\"blob/main\", \"resolve/main\")\n",
        "\n",
        "    user_agent = \"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36\"\n",
        "    headers = {\"User-Agent\": user_agent}\n",
        "\n",
        "    # Authenticate Civitai using Bearer Token instead of URL Params\n",
        "    if civitai_token and \"civitai.com\" in url:\n",
        "        url = re.sub(r'([?&])token=[^&]+', r'\\1', url).rstrip('?&')\n",
        "        headers[\"Authorization\"] = f\"Bearer {civitai_token}\"\n",
        "        print(f\"[DEBUG] Applied API Token to Header\")\n",
        "\n",
        "    print(f\"[DEBUG] Resolving Redirects to Bypass Cloudflare...\")\n",
        "\n",
        "    try:\n",
        "        session = requests.Session()\n",
        "        response = session.get(url, headers=headers, stream=True, allow_redirects=False)\n",
        "\n",
        "        final_url = url\n",
        "        # Handle S3 / CDN Redirects manually to drop the Authorization header\n",
        "        while response.status_code in[301, 302, 303, 307, 308]:\n",
        "            redirect_url = response.headers.get('Location')\n",
        "            if \"Authorization\" in headers:\n",
        "                del headers[\"Authorization\"] # Crucial: Prevent AWS 400 Bad Request\n",
        "            response = session.get(redirect_url, headers=headers, stream=True, allow_redirects=False)\n",
        "            final_url = redirect_url\n",
        "\n",
        "        # Get optimal filename from final response headers\n",
        "        if not filename:\n",
        "            cd = response.headers.get('content-disposition', '')\n",
        "            fname = re.findall('filename=\"?([^\"]+)\"?', cd)\n",
        "            if fname:\n",
        "                filename = fname[0]\n",
        "            else:\n",
        "                filename = unquote(url.split('/')[-1].split('?')[0])\n",
        "                if not filename or filename == \"models\":\n",
        "                    filename = f\"model_{int(time.time())}.safetensors\"\n",
        "\n",
        "        response.close()\n",
        "\n",
        "    except Exception as e:\n",
        "        print(f\"[WARNING] Redirect resolution failed: {e}\")\n",
        "        final_url = url\n",
        "\n",
        "    print(f\"[DEBUG] Target File  : {filename}\")\n",
        "    print(f\"[DEBUG] Final URL    : {final_url.split('?')[0]}... (params hidden)\")\n",
        "\n",
        "    # Execute Aria2c on the RESOLVED final URL\n",
        "    cmd = f\"aria2c --console-log-level=notice -c -x 16 -s 16 -k 1M -U '{user_agent}' -o '{filename}' '{final_url}' -d '{destination_dir}'\"\n",
        "    print(f\"[DEBUG] Command      : aria2c ... '{filename}'\")\n",
        "\n",
        "    result = subprocess.run(cmd, shell=True)\n",
        "\n",
        "    # --- FALLBACK DOWNLOADER ---\n",
        "    if result.returncode != 0:\n",
        "        print(f\"\\n[WARNING] aria2c failed with code {result.returncode}. FALLING BACK TO PYTHON REQUESTS...\")\n",
        "        filepath = os.path.join(destination_dir, filename)\n",
        "        try:\n",
        "            response = session.get(final_url, headers=headers, stream=True)\n",
        "            total_size = int(response.headers.get('content-length', 0))\n",
        "            with open(filepath, 'wb') as f, tqdm(\n",
        "                desc=filename, total=total_size, unit='iB', unit_scale=True, unit_divisor=1024\n",
        "            ) as bar:\n",
        "                for chunk in response.iter_content(chunk_size=1048576):\n",
        "                    if chunk:\n",
        "                        f.write(chunk)\n",
        "                        bar.update(len(chunk))\n",
        "            print(f\"[DEBUG] Python Fallback Download Successful!\")\n",
        "        except Exception as e:\n",
        "            print(f\"[ERROR] Python Fallback also failed: {e}\")\n",
        "\n",
        "    print(f\"[DEBUG] Current contents of {destination_dir}:\")\n",
        "    os.system(f\"ls -lh '{destination_dir}'\")\n",
        "    print(f\"============================================================\\n\")\n",
        "\n",
        "# --- 1. CHECKPOINTS ---\n",
        "print(\"\\n[PHASE 1] CHECKPOINTS\")\n",
        "if custom_model_url:\n",
        "    download_file(custom_model_url, models_dir)\n",
        "\n",
        "# --- 2. LORAS ---\n",
        "print(\"\\n[PHASE 2] LORAS\")\n",
        "if custom_lora_url:\n",
        "    lora_urls = list(dict.fromkeys([u.strip() for u in custom_lora_url.split(',') if u.strip()]))\n",
        "    for i, url in enumerate(lora_urls):\n",
        "        print(f\"\\n-> Triggering LoRA {i+1} of {len(lora_urls)}\")\n",
        "        download_file(url, lora_dir)\n",
        "        time.sleep(1)\n",
        "\n",
        "print(\"\\n[DEBUG] Mirroring LoRAs to Lycoris folder...\")\n",
        "for item in os.listdir(lora_dir):\n",
        "    src = os.path.join(lora_dir, item)\n",
        "    dst = os.path.join(lycoris_dir, item)\n",
        "    if os.path.isfile(src) and item.endswith(('.safetensors', '.ckpt', '.pt')) and not os.path.exists(dst):\n",
        "        os.symlink(src, dst)\n",
        "\n",
        "# --- 3. ADETAILER & UPSCALERS ---\n",
        "print(\"\\n[PHASE 3] ADETAILER & UPSCALERS\")\n",
        "\n",
        "adetailer_models_list =[\n",
        "    (\"https://huggingface.co/Bingsu/adetailer/resolve/main/face_yolov8n.pt\", \"face_yolov8n.pt\"),\n",
        "    (\"https://huggingface.co/Bingsu/adetailer/resolve/main/hand_yolov8n.pt\", \"hand_yolov8n.pt\"),\n",
        "    (\"https://huggingface.co/Bingsu/adetailer/resolve/main/person_yolov8n-seg.pt\", \"person_yolov8n-seg.pt\")\n",
        "]\n",
        "for url, filename in adetailer_models_list:\n",
        "    download_file(url, adetailer_dir, filename)\n",
        "\n",
